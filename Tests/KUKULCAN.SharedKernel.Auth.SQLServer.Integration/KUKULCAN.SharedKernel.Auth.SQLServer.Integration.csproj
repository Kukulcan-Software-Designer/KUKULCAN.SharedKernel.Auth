<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <LangVersion>latestmajor</LangVersion>
      <Nullable>enable</Nullable>
      <ImplicitUsings>enable</ImplicitUsings>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <IsPackable>false</IsPackable>
      <IsTestProject>true</IsTestProject>
      <RootNamespace>KUKULCAN.SharedKernel.Auth.SQLServer.Integration</RootNamespace>
      <AssemblyName>KUKULCAN.SharedKernel.Auth.SQLServer.Integration</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
      <ProjectReference Include="..\..\Source\KUKULCAN.SharedKernel.Auth\KUKULCAN.SharedKernel.Auth.csproj" />
